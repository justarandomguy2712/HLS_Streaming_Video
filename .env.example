# Đường dẫn tương đối tính từ thư mục gốc của repository.
HLS_DATA_DIR=data
HLS_FFMPEG_BIN=ffmpeg
HLS_FFPROBE_BIN=ffprobe

# Dùng local để kiểm thử HLS cục bộ, hoặc auto để giữ hành vi các phase trước.
STORAGE_PROVIDER=r2
LOCAL_STORAGE_MODE=temporary
KEEP_ORIGINAL_VIDEO=false
DELETE_LOCAL_AFTER_VERIFICATION=true
STREAM_SEGMENTS_TO_R2=true
# Cơ chế JSON của Phase 08 cũ, chỉ dùng hồi quy. Production đọc danh mục D1.
ONLINE_LIBRARY_ENABLED=false

MAX_UPLOAD_BYTES=53687091200
UPLOAD_CHUNK_SIZE_MB=8
HLS_SEGMENT_DURATION=4
VIDEO_PROCESSING_CONCURRENCY=1
MAX_PENDING_SEGMENTS=32
MAX_TEMP_STORAGE_GB=40
MIN_FREE_DISK_GB=10

VIDEO_PROCESSING_MODE=auto
PRESERVE_RESOLUTION=true
PRESERVE_FRAME_RATE=true
ALLOW_DOWNSCALING=false
VIDEO_LIST_PAGE_SIZE=20
VIDEO_ENCODER=auto
ENABLE_NVENC=true
ALLOW_STREAM_COPY=true
MAX_COPY_SEGMENT_SECONDS=0

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_PUBLIC_BASE_URL=
R2_UPLOAD_CONCURRENCY=4
R2_UPLOAD_MAX_RETRIES=5
R2_CONNECT_TIMEOUT_SECONDS=5
R2_READ_TIMEOUT_SECONDS=30

PLAYER_FORWARD_BUFFER_SECONDS=60
PLAYER_BACK_BUFFER_SECONDS=30

# Production chạy companion CLI; chế độ HTTP cũ chỉ để chạy test Phase 01–07.
ENABLE_LEGACY_LAB_HTTP=false
WORKER_ENDPOINT=
PROCESSING_SERVICE_TOKEN=
REMOTE_PROCESSING_ENABLED=false
LOCAL_BACKEND_HOST=127.0.0.1
LOCAL_BACKEND_PORT=8000
DELETE_SOURCE_FILE_AFTER_SUCCESS=false
